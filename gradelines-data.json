        "claim": "For routine care, a minor’s authority to consent is not a single nationwide rule; state law, service type, custody, confidentiality, emergency circumstances, insurer/provider policy, and capacity rules matter. Utah’s statutory exception for sexually transmitted infection treatment is not a blanket minor-consent rule.",
        "classification": "legal threshold",
        "typical_range": "Generally under 18 requires authorized adult involvement unless a specific law/exception applies",
        "variability": "The correct answer can differ by service and facts; confidential-care rules and mandatory reporting are complex.",
        "evidence_strength": "moderate",
        "what_educators_should_not_assume": "that a student can or cannot consent to all health care solely because of age, or that educators should provide legal/medical advice.",
        "jurisdiction": "Utah; state/service/provider variation",
        "source_ids": [
          18,
          20
        ],
        "checked_date": "2026-09-07",
        "ambiguity_or_caveat": "Verify current law and provider policy for the exact service; refer families/students to qualified health and legal resources."
      },
      {
        "claim_id": "C24",
        "topic": "Driving",
        "claim": "In Utah, a learner permit is available at 15. A 15-year-old must hold it six months and until 16, complete driver education, log 40 practice hours including 10 after sunset, and have adult supervision; a parent/guardian signs financial responsibility for a driver under 18.",
        "classification": "legal threshold",
        "typical_range": "Utah learner permit 15; licensing progression 16+",
        "variability": "Eligibility also depends on identity/residency documents, tests, vision, driving education, practice, financial responsibility, and individual safe-driving skill.",
        "evidence_strength": "strong",
        "what_educators_should_not_assume": "that age 15 means independent driving or that a license proves mature judgment in every context.",
        "jurisdiction": "Utah",
        "source_ids": [
          16
        ],
        "checked_date": "2026-09-07"
      },
      {
        "claim_id": "C25",
        "topic": "Driving",
        "claim": "Utah licensed drivers ages 16–17 have a midnight–5 a.m. restriction with stated exceptions and, for the first six months or until 18, passenger limits for non-immediate-family passengers unless an exception applies.",
        "classification": "legal threshold",
        "typical_range": "Utah ages 16–17; first six months/until 18",
        "variability": "Restrictions, exceptions, insurance conditions, family rules, and driving competence affect actual travel.",
        "evidence_strength": "strong",
        "what_educators_should_not_assume": "that a 16- or 17-year-old license permits unrestricted peer travel or that permission equals readiness.",
        "jurisdiction": "Utah",
        "source_ids": [
          17
        ],
        "checked_date": "2026-09-07"
      },
      {
        "claim_id": "C30",
        "topic": "Boating, hunting, and machinery",
        "claim": "Utah requires ages 12–17 to complete youth personal-watercraft education before operating a PWC. Hunting has activity-specific thresholds: Utah says big-game hunting begins at 12, youth under 16 need responsible adult accompaniment in the field for listed activities, and some upland/waterfowl opportunities have no minimum age if education/licensing requirements are met.",
        "classification": "legal threshold",
        "typical_range": "Utah PWC education: 12–17; big game: 12+; many rules vary by game/activity",
        "variability": "Licenses, permits, safety courses, weapon law, supervision, land rules, season, equipment, operator skill, and federal law affect participation.",
        "evidence_strength": "strong",
        "what_educators_should_not_assume": "that a general “boating age” or “hunting age” exists, that a certificate equals safe operation, or that a youth may operate hazardous machinery because recreational participation is permitted.",
        "jurisdiction": "Utah; federal machinery law separately applies",
        "source_ids": [
          27,
          28,
          14
        ],
        "checked_date": "2026-09-07"
      },
      {
        "claim_id": "C35",
        "topic": "Professional performance",
        "claim": "Utah permits certain acting and performing work with parent/guardian/custodian consent without the chapter’s specific age limitations, while separate Utah entertainment provisions address compensated minor performers and trusts. Work must still comply with applicable safety, education, contract, tax, labor, platform, and federal rules.",
        "classification": "legal threshold",
        "typical_range": "No single Utah minimum age for all acting/performing under the cited exception; requirements are fact-specific",
        "variability": "Whether an arrangement is casual work, employment, self-employment, content creation, union work, or a compensated performance changes obligations.",
        "evidence_strength": "moderate",
        "what_educators_should_not_assume": "that a child performer is automatically legally independent, that every online post is protected work, or that an adult’s consent settles all safety and contract issues.",
        "jurisdiction": "Utah; federal/industry/platform variation",
        "source_ids": [
          15,
          18
        ],
        "checked_date": "2026-09-07",
        "ambiguity_or_caveat": "Check current Utah performer/trust provisions and any union or production rules for the specific arrangement."
      }
