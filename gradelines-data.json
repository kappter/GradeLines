  "claims_not_to_display": [
    {
      "id": "ND01",
      "area": "Simplistic age–grade mapping",
      "claim_not_to_display": "Every student in a given grade is the same age, and grade or age reveals maturity, ability, prior opportunity, or readiness.",
      "why_not": "The declared inputs treat grade as an instructional placement. Entry cutoffs, retention, acceleration, mobility, interrupted schooling, disability services, and local placement decisions create ordinary within-grade age diversity.",
      "source_backed_replacement": "Use the conventional age descriptor only for broad planning, retain the stated overlap, and determine access or support from current evidence about the learner and the controlling program rule.",
      "classifications": [
        "cultural convention",
        "instructional expectation"
      ],
      "source_ids": [
        2,
        1,
        4
      ]
    },
    {
      "id": "ND02",
      "area": "Puberty, sex, gender, and sexual orientation",
      "claim_not_to_display": "A student’s body, pubertal timing, assigned sex, appearance, pronouns, gender identity, gender expression, or sexual orientation determines the others or predicts cognition, conduct, interests, capacity, or readiness.",
      "why_not": "The inputs describe broad sex-associated clinical puberty ranges and distinguish sex, gender identity, gender expression, and sexual orientation. Growth references are distributions and are not diagnostic instruments.",
      "source_backed_replacement": "Treat puberty timing as variable and private; keep the constructs distinct; use names and language consistent with policy and law; and refer health concerns rather than diagnosing them in school.",
      "classifications": [
        "developmental tendency",
        "instructional expectation"
      ],
      "source_ids": [
        6,
        7,
        5
      ]
    },
    {
      "id": "ND03",
      "area": "Maslow as a rigid instructional sequence",
      "claim_not_to_display": "Students must finish each lower rung of Maslow’s hierarchy before they can learn, create, contribute, or pursue purpose.",
      "why_not": "The common foundation classifies the 1943 hierarchy as historically influential but contested and notes that Maslow presented a proposed framework requiring research rather than a classroom diagnostic sequence.",
      "source_backed_replacement": "Treat safety, belonging, competence, autonomy, relationships, and purpose as interacting conditions. Use current evidence and learner voice instead of assigning an individual to a rung.",
      "classifications": [
        "developmental tendency",
        "instructional expectation"
      ],
      "source_ids": [
        9,
        10,
        8
      ]
    },
    {
      "id": "ND04",
      "area": "Brain-maturity determinism",
      "claim_not_to_display": "The adolescent brain is simply immature, or a particular birthday creates a fully mature brain and uniform adult judgment.",
      "why_not": "The research inputs describe multiple cognitive, executive, reward, learning, and social processes that change on different trajectories. Performance also differs by task, support, emotion, time pressure, and social context.",
      "source_backed_replacement": "Describe development as continued, differentiated, plastic, and context-sensitive. Pair high intellectual expectations with planning tools, rehearsal, time, feedback, and opportunities to practice.",
      "classifications": [
        "developmental tendency",
        "instructional expectation"
      ],
      "source_ids": [
        8,
        75
      ]
    },
    {
      "id": "ND05",
      "area": "Teen risk stereotypes",
      "claim_not_to_display": "Teenagers are reckless, irrational, peer-controlled, or destined to make unsafe decisions.",
      "why_not": "The inputs report context-sensitive tendencies, not a universal trait. Social and emotional conditions can alter judgment in some settings; exploration and calibrated risk can also support learning, and peers can be prosocial.",
      "source_backed_replacement": "Design consequential decisions with private reflection, time to deliberate, rehearsal, clear boundaries, prosocial peer roles, and more than one route to participation without predicting an individual’s conduct.",
      "classifications": [
        "developmental tendency",
        "instructional expectation"
      ],
      "source_ids": [
        8,
        65
      ]
    },
    {
      "id": "ND06",
      "area": "Legal permission and readiness",
      "claim_not_to_display": "Meeting a minimum age, holding a permit or license, obtaining consent, or being allowed to participate proves that a student is ready, safe, competent, insured, supported, or accepted by every provider.",
      "why_not": "The common legal foundation repeatedly distinguishes narrow eligibility rules from activity-specific training, supervision, skill, safety, consent, insurance, financial, provider, and institutional conditions.",
      "source_backed_replacement": "State the exact jurisdiction and threshold, then separately verify the student’s exact age, activity, supervision, training, provider rules, consent, accessibility, safety, and current law or policy. Never present permission as readiness.",
      "classifications": [
        "legal threshold",
        "practical possibility",
        "instructional expectation"
      ],
      "source_ids": [
        14,
        16,
        29,
        8
      ]
    }
  ]
}
