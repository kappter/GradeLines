      {
        "claim_id": "C21",
        "topic": "Banking and accounts",
        "claim": "Federal law does not prohibit minors from opening savings accounts, but account availability, co-owner/custodian requirements, identification, fees, online access, debit/credit features, and contract terms vary by state and financial institution.",
        "classification": "practical possibility",
        "typical_range": "Possible before 18; no general federal opening age",
        "variability": "A youth’s access may depend on documentation, trusted adult availability, account design, institution policy, and state contract/banking law.",
        "evidence_strength": "strong",
        "what_educators_should_not_assume": "that a minor can independently open every kind of bank, brokerage, payment-app, credit, or business account, or that access establishes money-management readiness.",
        "jurisdiction": "Federal baseline; Utah/institution variation",
        "source_ids": [
          19
        ],
        "checked_date": "2026-09-07"
      },
      {
        "claim_id": "C33",
        "topic": "College and credentials",
        "claim": "There is no general U.S. legal minimum age for taking college coursework, enrolling in a college, or earning every technical credential. Admission, dual/concurrent enrollment, prerequisites, parental consent, placement, professional licensure, clinical-site, and credential-provider rules govern. The University of Utah’s HSUP illustrates institutional variation: it serves Utah high-school sophomores through seniors and requires ninth-grade completion, GPAs, active enrollment/homeschool status, and parental consent.",
        "classification": "practical possibility",
        "typical_range": "Possible before 18; particular program example generally begins after Grade 9",
        "variability": "Programs can admit younger, older, homeschooled, disabled, immigrant, or part-time learners under different criteria.",
        "evidence_strength": "strong",
        "what_educators_should_not_assume": "that grade 12 completion or age 18 is necessary for all college learning, or that college admission proves readiness for every workload, cost, or career decision.",
        "jurisdiction": "Institution/program/state variation",
        "source_ids": [
          31
        ],
        "checked_date": "2026-09-07"
      },
      {
        "claim_id": "C36",
        "topic": "Athletics",
        "claim": "School athletics and performing activities are institution/association governed, not a universal developmental entitlement. UHSAA’s 2026–27 rule bars association activity participation for a student who reached 19 before September 1 of the school year; it also has season, years-of-eligibility, scholastic, transfer, and activity rules.",
        "classification": "legal threshold",
        "typical_range": "UHSAA age threshold: not 19 before September 1; school/activity eligibility varies",
        "variability": "District, charter, private-school, state-association, NCAA/club, disability accommodation, medical clearance, and transfer rules differ.",
        "evidence_strength": "strong",
        "what_educators_should_not_assume": "that physical maturity, Grade 12 status, or permission to play proves safety/readiness, or that UHSAA rules govern every program.",
        "jurisdiction": "Utah association; institution/state variation",
        "source_ids": [
          34
        ],
        "checked_date": "2026-09-07"
      },
      {
        "claim_id": "C37",
        "topic": "Volunteering and civic contribution",
        "claim": "There is no general statewide or federal minimum age for all volunteering. Programs set safeguarding, consent, training, supervision, transportation, task, and background-check rules. AmeriCorps State and National, for example, requires age 17+ and qualifying citizenship/residency, while many local volunteer roles serve younger youth under provider policies.",
        "classification": "practical possibility",
        "typical_range": "No universal volunteer age; AmeriCorps State and National 17+",
        "variability": "The responsible organization determines participation; a student’s capacity, accessibility needs, family consent, schedule, and task risk matter.",
        "evidence_strength": "strong",
        "what_educators_should_not_assume": "that any volunteer role is available at any age, that volunteering needs no supervision, or that a service opportunity is safe/readiness-appropriate because it is unpaid.",
        "jurisdiction": "Federal program example; provider/state/institution variation",
        "source_ids": [
          35
        ],
        "checked_date": "2026-09-07"
      },
      {
        "claim_id": "C39",
        "topic": "Legal and readiness interpretation",
        "claim": "An age rule answers only a narrow eligibility question. Across employment, licenses, travel, aviation, accounts, recreation, contracts, college, and service, permission or eligibility must never be equated with developmental readiness, safety, capacity, financial access, supervision, consent, or institutional acceptance.",
        "classification": "instructional expectation",
        "typical_range": "All Grades 6–12 and beyond",
        "variability": "Readiness is task- and context-specific; it can be supported, assessed within role boundaries, and revisited.",
        "evidence_strength": "strong",
        "what_educators_should_not_assume": "that legal status predicts judgment, that a younger student is incapable, or that educators should make legal/medical capacity determinations.",
        "jurisdiction": "Cross-cutting U.S./Utah interpretation",
